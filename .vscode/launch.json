{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Web App",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/web/node_modules/.bin/next",
      "args": ["dev"],
      "cwd": "${workspaceFolder}/web",
      "runtimeArgs": ["--inspect"],
      "env": {
        "NODE_OPTIONS": "--inspect"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Debug Admin App",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/admin/node_modules/.bin/next",
      "args": ["dev"],
      "cwd": "${workspaceFolder}/admin",
      "runtimeArgs": ["--inspect"],
      "env": {
        "NODE_OPTIONS": "--inspect"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Debug Web App (pnpm)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "args": ["--filter", "web", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Debug Admin App (pnpm)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "args": ["--filter", "studio-admin", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Debug All Apps (pnpm)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "args": ["dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Debug Both Apps",
      "configurations": ["Debug Web App (pnpm)", "Debug Admin App (pnpm)"],
      "stopAll": true
    }
  ]
}