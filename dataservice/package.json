{
  "name": "@educatedplanet/dataservice",
  "version": "1.0.0",
  "description": "Business logic and service layer for EducatedPlanet platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "migrate": "ts-node -r dotenv/config src/scripts/run-migrations.ts",
    "migrate:list": "npm run migrate list",
    "migrate:up": "npm run migrate up",
    "migrate:run": "npm run migrate run"
  },
  "keywords": [
    "education",
    "tutors",
    "service",
    "business-logic",
    "mongodb"
  ],
  "author": "EducatedPlanet Team",
  "license": "MIT",
  "dependencies": {
    "@educatedplanet/common": "workspace:*",
    "@educatedplanet/models": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.3.34",
    "dotenv": "^16.0.3",
    "jsencrypt": "^3.5.4",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "mongoose": "^8.0.3",
    "node-rsa": "^1.1.1",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/validator": "^13.11.10",
    "ts-node": "^10.9.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}