{
  "name": "educatedplanet",
  "version": "1.0.0",
  "description": "Local tutor listing platform - Monorepo",
  "private": true,
  "workspaces": [
    "web",
    "admin",
    "models",
    "dataservice",
    "common"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "type-check": "turbo run type-check",
    "dev:web": "pnpm --filter web dev",
    "dev:admin": "pnpm --filter admin dev",
    "build:models": "pnpm --filter models build",
    "build:web": "pnpm --filter web build",
    "build:admin": "pnpm --filter admin build"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.20.0",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "mongodb": "^6.20.0",
    "mongoose": "^8.19.2",
    "validator": "^13.15.20"
  }
}